{
  "name": "flutter-appium-e2e-framework",
  "version": "1.0.0",
  "description": "Enterprise-grade E2E automation framework for Flutter Android APKs using Appium 2.x",
  "main": "index.js",
  "scripts": {
    "test": "mocha tests/**/*.spec.js --timeout 90000",
    "test:ci": "mocha tests/**/*.spec.js --timeout 120000 --reporter mochawesome --reporter-options reportDir=reports/html,reportFilename=index",
    "lint": "eslint ."
  },
  "dependencies": {
    "appium-flutter-driver": "^2.0.0",
    "exceljs": "^4.4.0",
    "selenium-webdriver": "^4.46.0",
    "webdriverio": "^8.38.2",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "chai": "^4.4.1",
    "mocha": "^10.4.0",
    "mochawesome": "^7.1.3"
  }
}
