{
  "name": "flutter-appium-framework",
  "version": "1.0.0",
  "description": "E2E Automation Framework for Flutter Apps using Appium",
  "main": "index.js",
  "scripts": {
    "test": "wdio run ./config/wdio.conf.js",
    "report:merge": "mochawesome-merge reports/json/*.json > reports/mochawesome.json",
    "report:generate": "marge reports/mochawesome.json -f report -o reports/html",
    "test:full": "npm run test & npm run report:merge & npm run report:generate",
    "test:ci": "npx mocha tests/e2e/boundaryValidation.test.js --reporter mochawesome --reporter-options reportDir=reports/json,reportFilename=results && npm run report:merge && npm run report:generate && node src/utils/excelReporter.js"
  },
  "dependencies": {
    "appium": "^2.11.3",
    "appium-flutter-driver": "^2.6.2",
    "appium-uiautomator2-driver": "^3.7.8"
  },
  "devDependencies": {
    "@wdio/appium-service": "^9.0.0",
    "@wdio/cli": "^9.30.0",
    "@wdio/local-runner": "^9.0.0",
    "@wdio/mocha-framework": "^9.0.0",
    "@wdio/spec-reporter": "^9.0.0",
    "chai": "^4.4.1",
    "exceljs": "^4.4.0",
    "mochawesome": "^7.1.3",
    "mochawesome-merge": "^4.3.0",
    "mochawesome-report-generator": "^6.2.0",
    "wdio-mochawesome-reporter": "^7.0.0",
    "winston": "^3.14.2"
  },
  "keywords": [
    "flutter",
    "appium",
    "automation",
    "qa",
    "e2e"
  ],
  "author": "",
  "license": "ISC"
}
